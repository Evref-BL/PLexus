{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "allowJs": true,
    "checkJs": true,
    // The scripts carry no annotations and catch node APIs that throw Error.
    // Demanding either throughout would be a rewrite; what moves under them is
    // the package they import, and that is checked either way.
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "types": ["node"]
  },
  // The scripts import the package as the built dist, the way node runs
  // them, so this config reads declarations the build has to emit first.
  // That is why "check" runs it after "build" and not with "typecheck".
  "include": ["scripts/**/*.mjs", "test/**/*.mjs"]
}
