{
  "name": "plexus",
  "version": "0.15.2",
  "private": true,
  "description": "Pharo image lifecycle management and MCP server forwarding.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Evref-BL/PLexus.git"
  },
  "type": "module",
  "bin": {
    "plexus": "./packages/plexus/dist/cli.js",
    "plexus-gateway": "./packages/plexus/dist/gateway/server/index.js"
  },
  "workspaces": [
    "packages/plexus"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "npm run typecheck && npm run build && npm run typecheck:scripts && npm test",
    "build": "npm run clean -w @evref-bl/plexus && npm run build -w @evref-bl/plexus",
    "test": "npm run test --workspaces && npm run test:smoke-policy",
    "coverage": "npm run coverage --workspaces",
    "coverage:all": "npm run coverage",
    "test:smoke-policy": "node --test test/scripts/*.test.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "clean": "npm run clean --workspaces",
    "smoke:start-route-stop": "npm run build && node scripts/smoke-start-route-stop.mjs",
    "verify:env": "node scripts/verify-environment.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
