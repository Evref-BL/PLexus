{
  "name": "@evref-bl/plexus",
  "version": "0.17.0",
  "private": false,
  "description": "PLexus: Pharo images as directories and processes, and forwarding to the MCP servers they run.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Evref-BL/PLexus.git",
    "directory": "packages/plexus"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "plexus": "dist/cli.js"
  },
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@evref-bl/pharo-launcher-mcp": "0.5.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "1.10.0"
  },
  "optionalDependencies": {
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1"
  }
}
