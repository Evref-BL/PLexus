{
  "name": "@evref-bl/plexus",
  "version": "0.1.0",
  "private": false,
  "description": "PLexus CLI for project-scoped Pharo runtime orchestration.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Evref-BL/PLexus.git",
    "directory": "packages/plexus-core"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "plexus": "dist/cli.js"
  },
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@evref-bl/pharo-launcher-mcp": "^0.1.3",
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
